# Set these as environment variables on the relevant Lambda functions.
# Real values are account-specific and are not committed.

# NotifyLambda, Subscribe, Unsubscribe
TOPIC_ARN=arn:aws:sns:us-east-1:<account-id>:OrderNotifications

# BackupLambda, GeneratePDF
S3_BUCKET_NAME=orders-backup-<account-id>
